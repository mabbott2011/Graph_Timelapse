{
	"name": "graph-timelapse",
	"version": "0.2.0",
	"description": "Obsidian plugin: records the graph view over time and plays it back as an embeddable timelapse.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint src"
	},
	"keywords": [
		"obsidian",
		"graph",
		"timelapse"
	],
	"author": "Shady Knoll Labs",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "22.20.5",
		"builtin-modules": "5.5.0",
		"esbuild": "0.28.2",
		"obsidian": "1.14.4",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"@eslint/js": "^9.39.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"globals": "^17.14.0",
		"typescript-eslint": "^8.72.1"
	}
}
